# Copy to .env and fill in only what you need. Every provider falls back to a
# local mock when its credential is absent, so the demo runs with an empty file.

# API port and the base URL used to build public audio clip URLs.
# PUBLIC_BASE_URL must be reachable by Poke for audio attachments to play
# (use an ngrok/cloudflared tunnel when going live).
PORT=8787
PUBLIC_BASE_URL=http://localhost:8787

# Force every provider into mock mode even when credentials are present.
MOCK_MODE=0

# --- ElevenLabs (dynamic voice generation) --------------------------------
# Create a key at https://elevenlabs.io -> Profile -> API Keys
ELEVENLABS_API_KEY=
ELEVENLABS_BASE_URL=https://api.elevenlabs.io
ELEVENLABS_MODEL_ID=eleven_turbo_v2_5
# Voice id from https://elevenlabs.io/app/voice-library (default: "George")
ELEVENLABS_VOICE_ID=JBFqnCBsd6RMkjVDRZzb
# Optional second voice used only by drill mode (the aggressive coach persona).
# Defaults to "Adam - Dominant, Firm" (pNInz6obpgDQGcFmaJgB) when empty.
ELEVENLABS_DRILL_VOICE_ID=

# --- Coach personality ----------------------------------------------------
# Mode new sessions start in: roast (dry, sarcastic) or drill (shouted, aggressive).
COACH_DEFAULT_MODE=roast

# --- Healf (sponsor hooks) ------------------------------------------------
# POST {HEALF_API_URL}/v1/campaigns/{HEALF_CAMPAIGN_ID}/hooks
HEALF_API_KEY=
HEALF_API_URL=https://api.healf.com
HEALF_CAMPAIGN_ID=healf-run-hack

# --- Poke (group messaging webhook) --------------------------------------
# Inbound webhook URL for the group chat that receives the confession.
POKE_WEBHOOK_URL=
POKE_API_KEY=
POKE_MAX_ATTEMPTS=3
# Mock mode only: fail this many attempts before succeeding (demo error paths).
POKE_MOCK_FAIL_ATTEMPTS=0

# --- Poke AI (coaching sync + MCP ingestion) ------------------------------
# V2 API key from https://poke.com/settings/advanced. Messages are POSTed to
# {POKE_AI_BASE_URL}{POKE_AI_MESSAGE_PATH} as documented at https://poke.com/docs/api.
# Without a key the coaching channel records messages in a local outbox instead.
POKE_AI_API_KEY=
POKE_AI_BASE_URL=https://poke.com
POKE_AI_MESSAGE_PATH=/api/v1/inbound/api-message
POKE_AI_MAX_ATTEMPTS=3
# Bearer token Poke must send when calling our MCP server at /api/poke/mcp.
# Generate any random string; required before exposing the endpoint publicly.
POKE_MCP_TOKEN=

# --- Strava (tracking: distance, duration, speed -> pace) -----------------
# Create an API application at https://www.strava.com/settings/api. The
# callback domain there must match STRAVA_REDIRECT_URI's host.
STRAVA_CLIENT_ID=
STRAVA_CLIENT_SECRET=
# Optional: a refresh token makes the server start already connected.
STRAVA_REFRESH_TOKEN=
STRAVA_REDIRECT_URI=http://localhost:8787/api/strava/callback
STRAVA_SCOPE=read,activity:read
# Leaderboard name for imported activities when the athlete name is unknown.
STRAVA_RUNNER_NAME=Isaac
# Override only for tests/sandboxes.
STRAVA_API_BASE_URL=https://www.strava.com
STRAVA_AUTH_BASE_URL=https://www.strava.com
